<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme resources: placeholders until Theme.Apply puts vShell's colours in (every style uses them as DynamicResource) -->
    <SolidColorBrush x:Key="vx.Bg" Color="#FF1E1E2E"/>
    <SolidColorBrush x:Key="vx.Popup" Color="#F51E1E2E"/>
    <SolidColorBrush x:Key="vx.Panel" Color="#0ACDD6F4"/>
    <SolidColorBrush x:Key="vx.PanelBorder" Color="#A689B4FA"/>
    <Thickness x:Key="vx.PanelBorderThickness">1</Thickness>
    <SolidColorBrush x:Key="vx.Fg" Color="#FFCDD6F4"/>
    <SolidColorBrush x:Key="vx.FgDim" Color="#99CDD6F4"/>
    <SolidColorBrush x:Key="vx.Accent" Color="#FF89B4FA"/>
    <SolidColorBrush x:Key="vx.OnAccent" Color="#FF11111B"/>
    <SolidColorBrush x:Key="vx.Secondary" Color="#FFF5C2E7"/>
    <SolidColorBrush x:Key="vx.Hover" Color="#22CDD6F4"/>
    <SolidColorBrush x:Key="vx.Active" Color="#38CDD6F4"/>
    <SolidColorBrush x:Key="vx.Selected" Color="#5089B4FA"/>
    <SolidColorBrush x:Key="vx.Track" Color="#30CDD6F4"/>
    <SolidColorBrush x:Key="vx.Thumb" Color="#60CDD6F4"/>
    <SolidColorBrush x:Key="vx.Line" Color="#14CDD6F4"/>
    <SolidColorBrush x:Key="vx.Side" Color="#30000000"/>
    <CornerRadius x:Key="vx.Radius">8</CornerRadius>
    <CornerRadius x:Key="vx.ItemRadius">4</CornerRadius>
    <CornerRadius x:Key="vx.MenuRadius">8</CornerRadius>
    <CornerRadius x:Key="vx.TabRadius">6,6,0,0</CornerRadius>
    <system:Double x:Key="vx.TabWidth" xmlns:system="clr-namespace:System;assembly=System.Runtime">200</system:Double>

    <!-- the corner square between two scrollbars -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>

    <FontFamily x:Key="vx.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <!-- Options > Look (the window puts its own over these) -->
    <Thickness x:Key="vx.RowPad">0,4</Thickness>
    <sys:Double x:Key="vx.ListFont" xmlns:sys="clr-namespace:System;assembly=System.Runtime">12.5</sys:Double>

    <!-- ===== Scrollbars: thin, like vShell's widgets - but easy to grab: 12 px to aim at, the thumb widening from 6 to 10 px when the
         pointer is on the bar (or it's dragged), and never shorter than 40 px however long the content (vx.ThumbMin) ===== -->
    <vxui:ThumbMinConverter x:Key="vx.ThumbMin" xmlns:vxui="clr-namespace:vSuite.Ui"/>
    <ControlTemplate x:Key="vx.ThumbTemplate" TargetType="Thumb">
        <Border x:Name="Bd" CornerRadius="3" Margin="3" Background="{DynamicResource vx.Thumb}" Opacity="0.7"/>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                <Setter TargetName="Bd" Property="Margin" Value="1"/>
                <Setter TargetName="Bd" Property="CornerRadius" Value="5"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                <Setter TargetName="Bd" Property="Margin" Value="1"/>
                <Setter TargetName="Bd" Property="CornerRadius" Value="5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.ViewportSize>
                                <MultiBinding Converter="{StaticResource vx.ThumbMin}" ConverterParameter="40">
                                    <Binding Path="ViewportSize" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                </MultiBinding>
                            </Track.ViewportSize>
                            <Track.Thumb><Thumb Template="{StaticResource vx.ThumbTemplate}"/></Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.ViewportSize>
                                        <MultiBinding Converter="{StaticResource vx.ThumbMin}" ConverterParameter="40">
                                            <Binding Path="ViewportSize" RelativeSource="{RelativeSource TemplatedParent}"/>
                                            <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                        </MultiBinding>
                                    </Track.ViewportSize>
                                    <Track.Thumb><Thumb Template="{StaticResource vx.ThumbTemplate}"/></Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Panels drawn like vShell widgets (corner radius, outline from the widget style) ===== -->
    <Style x:Key="vx.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource vx.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource vx.PanelBorder}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource vx.PanelBorderThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource vx.Radius}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="vx.SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource vx.FgDim}"/>
        <Setter Property="Margin" Value="8,8,0,4"/>
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="vx.IconButton" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontFamily" Value="{StaticResource vx.Icons}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource vx.ItemRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource vx.Hover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource vx.Active}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
        </Style.Triggers>
    </Style>

    <!-- the tab strip's scroll arrows: keep scrolling while held -->
    <Style x:Key="vx.ScrollArrow" TargetType="RepeatButton">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontFamily" Value="{StaticResource vx.Icons}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource vx.FgDim}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Delay" Value="300"/>
        <Setter Property="Interval" Value="60"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource vx.ItemRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource vx.Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource vx.Active}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Options: an on / off switch and a choice of several ===== -->
    <Style x:Key="vx.Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Border x:Name="Track" DockPanel.Dock="Right" Width="40" Height="20" CornerRadius="10" Margin="16,0,0,0"
                                VerticalAlignment="Center" Background="{DynamicResource vx.Track}">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource vx.Fg}"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource vx.Accent}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource vx.Popup}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.85"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="vx.Choice" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <DockPanel Background="Transparent">
                        <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource vx.FgDim}" StrokeThickness="1.5"/>
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource vx.Accent}" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource vx.Accent}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource vx.Fg}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Options' page list (vShell settings' sidebar): an accent bar on the open page -->
    <Style x:Key="vx.NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="0,8,8,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Bar" CornerRadius="2" Margin="0,2" Background="{DynamicResource vx.Accent}" Visibility="Hidden"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource vx.Hover}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource vx.Hover}"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- one part of a row of joined buttons (Compact | Normal | Roomy): the picked one filled with the accent -->
    <Style x:Key="vx.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="12,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource vx.Hover}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource vx.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource vx.OnAccent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a plain text button (Options' "Open settings folder") -->
    <Style x:Key="vx.TextButton" TargetType="Button" BasedOn="{StaticResource vx.IconButton}">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Background" Value="{DynamicResource vx.Hover}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource vx.Active}"/></Trigger>
        </Style.Triggers>
    </Style>

    <!-- the command bar above the files: a button with a glyph and words (New ▾) -->
    <Style x:Key="vx.CommandButton" TargetType="Button" BasedOn="{StaticResource vx.IconButton}">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style x:Key="vx.CommandGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource vx.Icons}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="vx.CommandSeparator" TargetType="Rectangle">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{DynamicResource vx.PanelBorder}"/>
    </Style>

    <Style x:Key="vx.CaptionButton" TargetType="Button" BasedOn="{StaticResource vx.IconButton}">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <Style x:Key="vx.CloseButton" TargetType="Button" BasedOn="{StaticResource vx.CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFC42B1C"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="vx.TabClose" TargetType="Button" BasedOn="{StaticResource vx.IconButton}">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="FontSize" Value="8"/>
        <Setter Property="Foreground" Value="{DynamicResource vx.FgDim}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="vx.CrumbButton" TargetType="Button" BasedOn="{StaticResource vx.IconButton}">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="7,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <Style x:Key="vx.CrumbArrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource vx.Icons}"/>
        <Setter Property="FontSize" Value="8"/>
        <Setter Property="Foreground" Value="{DynamicResource vx.FgDim}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="1,1,1,0"/>
        <Setter Property="Text" Value="&#xE76C;"/>
    </Style>

    <!-- the arrow between two crumbs: a button that lists the folder's subfolders (Explorer's breadcrumb dropdown) -->
    <Style x:Key="vx.CrumbArrowButton" TargetType="Button" BasedOn="{StaticResource vx.IconButton}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="FontSize" Value="8"/>
        <Setter Property="Foreground" Value="{DynamicResource vx.FgDim}"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Content" Value="&#xE76C;"/>
    </Style>

    <Style x:Key="vx.AddressBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource vx.Fg}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource vx.Accent}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource vx.Popup}" BorderBrush="{DynamicResource vx.PanelBorder}" BorderThickness="1"
                            CornerRadius="{DynamicResource vx.ItemRadius}" Padding="8,4">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Sidebar tree (rows highlight across the full width; the indent comes from the node's depth) ===== -->
    <HierarchicalDataTemplate x:Key="vx.FolderNodeTemplate" ItemsSource="{Binding Children}">
        <TextBlock Text="{Binding Name}"/>
    </HierarchicalDataTemplate>

    <Style x:Key="vx.ExpanderToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <TextBlock x:Name="Glyph" Text="&#xE76C;" FontFamily="{StaticResource vx.Icons}" FontSize="8"
                                   Foreground="{DynamicResource vx.FgDim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Glyph" Property="Text" Value="&#xE70D;"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource vx.Fg}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ItemTemplate" Value="{StaticResource vx.FolderNodeTemplate}"/>
        <!-- no scroller of its own: the sidebar scrolls both trees together -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeView"><ItemsPresenter/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
        <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Row" Background="Transparent" CornerRadius="{DynamicResource vx.ItemRadius}" Padding="2,4" Margin="0,0,0,1">
                            <DockPanel>
                                <ToggleButton x:Name="Expander" DockPanel.Dock="Left" Margin="{Binding IndentMargin}" Style="{StaticResource vx.ExpanderToggle}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Image x:Name="Icon" DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="2,0,7,0"/>
                                <TextBlock x:Name="Label" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource vx.Hover}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource vx.Selected}"/></Trigger>
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource vx.Active}"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource vx.FgDim}"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== File list ===== -->
    <Style TargetType="ListView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource vx.FgDim}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" Background="Transparent" Padding="8,6" Margin="0,0,2,4" CornerRadius="{DynamicResource vx.ItemRadius}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="9" Margin="0,0,-4,4" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent">
                                        <Rectangle Width="1" Margin="0,7" Fill="{DynamicResource vx.Track}" HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource vx.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
                        </Trigger>
                        <Trigger Property="Role" Value="Padding">
                            <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Bd" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,0,0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource vx.ItemRadius}" Padding="{DynamicResource vx.RowPad}" SnapsToDevicePixels="True">
                        <GridViewRowPresenter VerticalAlignment="Center" Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource vx.Hover}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource vx.Selected}"/></Trigger>
                        <DataTrigger Binding="{Binding IsCut}" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource vx.Active}"/></DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- renaming in place -->
    <Style x:Key="vx.RenameBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource vx.Popup}"/>
        <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource vx.Fg}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource vx.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource vx.Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="3,1"/>
        <Setter Property="Margin" Value="-4,-3,4,-3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource vx.ItemRadius}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Menus (vXplorer's own right-click menu), drawn like vShell's popups ===== -->
    <Style x:Key="vx.MenuGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource vx.Icons}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource vx.Popup}" BorderBrush="{DynamicResource vx.PanelBorder}" BorderThickness="1"
                            CornerRadius="{DynamicResource vx.MenuRadius}" Padding="4" Margin="0,0,10,10" MinWidth="220">
                        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.35"/></Border.Effect>
                        <!-- a long menu (the address bar's list of a big folder's subfolders) scrolls instead of running off the screen -->
                        <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="10,4" Background="{DynamicResource vx.Track}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource vx.Fg}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource vx.ItemRadius}" Padding="6,6,8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Gesture"/>
                                <ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="IconHost" ContentSource="Icon" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Check" Text="&#xE73E;" Style="{StaticResource vx.MenuGlyph}" FontSize="12" Foreground="{DynamicResource vx.Accent}" Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="6,0,18,0"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource vx.FgDim}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;" Style="{StaticResource vx.MenuGlyph}" FontSize="8" Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right"
                                   HorizontalOffset="6" VerticalOffset="-6" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource vx.Popup}" BorderBrush="{DynamicResource vx.PanelBorder}" BorderThickness="1"
                                        CornerRadius="{DynamicResource vx.MenuRadius}" Padding="4" Margin="0,0,10,10" MinWidth="200"
                                        Grid.IsSharedSizeScope="True" TextElement.Foreground="{DynamicResource vx.Fg}">
                                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.35"/></Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource vx.Hover}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

</ResourceDictionary>
