@* One of the side panel's places (Hosts, Activity …): an icon, its name and a count on the right, picked while its page is open.
   Inside <div class="places">. The side panel itself is the app's own (its tree of hosts, sources …). *@
@implements IDisposable
@inject NavigationManager Nav

<a class="node @(Here ? "sel" : "")" href="@Href" title="@Title"><Icon Name="@Glyph" /><span class="nm">@Name</span>@if (!string.IsNullOrEmpty(Count)) {<span class="c @CountClass" title="@CountTitle">@Count</span>}</a>

@code {
    [Parameter, EditorRequired] public string Href { get; set; }
    [Parameter, EditorRequired] public string Glyph { get; set; }
    [Parameter, EditorRequired] public string Name { get; set; }
    /// <summary>The text on the right ("8", "v12", "3 out"), or nothing.</summary>
    [Parameter] public string Count { get; set; }
    /// <summary>The count's look ("warn-text", "bad-text", "hot").</summary>
    [Parameter] public string CountClass { get; set; }
    /// <summary>The count's own tooltip (what it counts).</summary>
    [Parameter] public string CountTitle { get; set; }
    [Parameter] public string Title { get; set; }
    /// <summary>Also picked on the pages under it ("/automations/nightly" for "/automations").</summary>
    [Parameter] public bool AndBelow { get; set; }

    bool Here
    {
        get
        {
            string path = Tabs.PathOf(Nav.Uri);
            return path == Href || (AndBelow && path.StartsWith(Href.TrimEnd('/') + "/"));
        }
    }

    protected override void OnInitialized() { Nav.LocationChanged += Moved; }
    void Moved(object sender, LocationChangedEventArgs e) { InvokeAsync(StateHasChanged); }
    public void Dispose() { Nav.LocationChanged -= Moved; }
}
