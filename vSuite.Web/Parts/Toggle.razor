<button type="button" class="switch @(Value ? "on" : "")" role="switch" aria-checked="@(Value ? "true" : "false")" title="@Title" @onclick="Flip" disabled="@Disabled"><i></i></button>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool Disabled { get; set; }

    Task Flip() { return ValueChanged.InvokeAsync(!Value); }
}
