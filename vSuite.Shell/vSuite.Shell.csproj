<Project Sdk="Microsoft.NET.Sdk">

  <!-- vSuite.Shell: Windows' icons and thumbnails (ShellIcons), for vXplorer and vView. A separate project because it needs Vanara,
       which vShell doesn't use. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>vSuite.Shell</AssemblyName>
    <RootNamespace>vSuite.Shell</RootNamespace>
    <Version>1.0.28</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\vSuite.Core\vSuite.Core.csproj" />
    <PackageReference Include="Vanara.Windows.Shell" Version="5.0.8" />
  </ItemGroup>

</Project>